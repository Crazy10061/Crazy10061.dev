---
// src/components/DosPlayer.astro
interface Props {
    bundleUrl: string;
    id?: string;
}

const { bundleUrl, id = "dos-container" } = Astro.props;
---

<!-- Load js-dos CSS and JS globally via jsDelivr -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/js-dos@8.5.4/dist/js-dos.css" />
<script src="https://cdn.jsdelivr.net/npm/js-dos@8.5.4/dist/js-dos.js"></script>

<div class="dos-wrapper">
    <div id={id} class="dos-box" data-bundle-url={bundleUrl}></div>
</div>

<style>
    .dos-wrapper {
        width: 100%;
        max-width: 800px;
        aspect-ratio: 4 / 3;
        margin: 0 auto;
        background: #000; /* Black background while loading */
    }

    .dos-box {
        width: 100%;
        height: 100%;
    }
</style>

<script>
    function initDosPlayers() {
        // Check if the global Dos function has loaded from the script tag
        // @ts-ignore
        if (typeof window.Dos === "undefined") return;

        const containers = document.querySelectorAll<HTMLElement>(".dos-box");

        containers.forEach((container) => {
            if (container.dataset.initialized === "true") return;
            container.dataset.initialized = "true";

            const bundleUrl = container.dataset.bundleUrl;
            if (!bundleUrl) return;

            // @ts-ignore
            window.Dos(container, {
                url: bundleUrl,
                autoStart: true,
            });
        });
    }

    // Run when window loads and support Astro View Transitions if enabled
    window.addEventListener("load", initDosPlayers);
    document.addEventListener("astro:page-load", initDosPlayers);
</script>