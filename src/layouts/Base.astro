---
import "@fontsource-variable/martian-mono";
import "@fontsource-variable/instrument-sans";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Crazy10061",
} = Astro.props;

const discordEmbed = {
  "component": {
  "type": 17,
      "components": [
    {
      "type": 9,
      "components": [
        {
          "type": 10,
          "content": "# **Crazy Website**\nThe ~~horrible~~ website of Crazy10061.\n-# aka Lexi"
        }
      ],
      "accessory": {
        "type": 11,
        "media": {
          "url": "https://crazy10061.dev/crazy.png"
        },
        "description": "Crazy"
      }
    },
    {
      "type": 1,
      "components": [
        {
          "type": 2,
          "style": 5,
          "url": "https://crazy10061.dev/projects/",
          "label": "Projects"
        },
        {
          "type": 2,
          "style": 5,
          "url": "https://crazy10061.dev/about/",
          "label": "About"
        },
        {
          "type": 2,
          "style": 5,
          "url": "https://github.com/Crazy10061",
          "label": "Github"
        }
      ]
    }
  ],
      "accent_color": 15548997
}
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d3d4cc" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <script
        id="discord:component-embed"
        type="application/json"
        set:html={JSON.stringify(discordEmbed)}
    />

  </head>
  <body>
    <Header />
    <main class="frame">
      <slot />
    </main>
    <Footer />
  </body>
</html>
